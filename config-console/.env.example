# Copy this file to `.env` (same folder). Vite does NOT read `.env.example` — without `.env`,
# the app stays in Local console mode.
# When true, the UI loads/saves via the Node API + Postgres instead of localStorage.
#
# Security: any VITE_* value is exposed in the browser bundle — never put API keys or DB passwords here.
# Database URLs, ESA_PROCESS_SEQUENCE_API_KEY, etc. belong in server/.env only. See README.md → Security.

VITE_USE_API=true

# Optional: same as server PUBLIC_BASE_PATH for subpath deploy (e.g. /decisioning-portal). Omit for root.
# VITE_PUBLIC_BASE_PATH=/decisioning-portal

# Optional: absolute API URL. If unset, the Vite dev server proxies `/api` (see vite.config.ts).
# VITE_API_URL=http://localhost:4000
#
# If the bundle was built with the wrong VITE_API_URL (404 HTML "Cannot POST /api/…"), rebuild with:
# VITE_API_RELATIVE=true
# …so `/api` always uses the browser’s current host (same as leaving VITE_API_URL unset).
#
# If server/.env sets PORT to something other than 4000, set this so Vite proxies to the same port:
# VITE_DEV_API_PROXY_TARGET=http://localhost:5000
