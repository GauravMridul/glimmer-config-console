{
  "name": "config-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "server": "node server/index.mjs",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.app.json --noEmit",
    "build": "npm run typecheck && vite build",
    "build:corpus": "node scripts/build-mapping-corpus.mjs",
    "build:sfdc-corpus": "node scripts/build-sfdc-corpus.mjs",
    "preview": "vite preview",
    "docker:build": "bash scripts/docker-build.sh"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
