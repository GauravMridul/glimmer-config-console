# Copy to server/.env — connection string for Postgres. server/.env is gitignored; do not commit it.
# Single DB with all three tables (see schema.sql), or set ESA + DM URLs separately.
# Security checklist: ../README.md → Security

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/config_console
# Test request → Fill from Salesforce: ESA DB must include `query_object_relationship_map`
# (same table External Service Adapter uses) so SOQL matches ESA.
#
# AWS RDS example (password must be URL-encoded in the URI: @→%40 $→%24 %→%25 #→%23):
# DATABASE_URL=postgresql://MY_USER:MY_ENCODED_PASSWORD@micro-service.cluster-xxxx.ap-south-1.rds.amazonaws.com:5432/externalserviceadapteruatdb?sslmode=require
# For RDS without a local CA bundle, set RDS_SSL_REJECT_UNAUTHORIZED=false (see below) or add sslrootcert.

# Optional: split databases (production-like). Defaults to DATABASE_URL when omitted.
# ESA_DATABASE_URL=postgresql://...

# query_object_relationship_map pool (Fill from Salesforce + GET …/query-object-relationship-map):
# - If QUERY_OBJECT_RELATIONSHIP_MAP_DATABASE_URL is set → use that URI.
# - Else if ESA_DATABASE_URL is set and DATABASE_URL is different → use DATABASE_URL (map on config-console DB).
# - Else → same pool as ESA (ESA_DATABASE_URL || DATABASE_URL).
# QUERY_OBJECT_RELATIONSHIP_MAP_DATABASE_URL=postgresql://...

# Option A — single URI (password must be URL-encoded if it contains @ $ % #):
# DM_DATABASE_URL=postgresql://dmuser:encodedpassword@host:5432/decisionmanageruatdb?sslmode=require

# Option B — discrete vars (password used verbatim; best for special characters):
# DM_HOST=your-rds.region.rds.amazonaws.com
# DM_PORT=5432
# DM_DB=decisionmanageruatdb
# DM_USER=dmuser
# DM_PASSWORD=your-raw-password
# Or: DM_PASSWORD_BASE64=<output of: printf %s 'yourpass' | base64>
# For Docker `--env-file`, prefer DM_PASSWORD_BASE64: plain DM_PASSWORD with `$` can break env parsing.

PORT=4000

# Behind AWS ALB / reverse proxy — set so Express trusts X-Forwarded-For / proto.
# TRUST_PROXY=1

# Docker / production: path to Vite dist (set automatically in the repo Dockerfile).
# STATIC_DIST_DIR=/app/dist

# UI URL prefix (no trailing slash). Must match Docker --build-arg PUBLIC_BASE_PATH and root .env VITE_PUBLIC_BASE_PATH for local builds.
# PUBLIC_BASE_PATH=/decisioning-portal

# If TLS fails with "unable to get local issuer certificate" against RDS, set:
# RDS_SSL_REJECT_UNAUTHORIZED=false
# (Prefer mounting the AWS RDS CA in production instead of disabling verify.)

# ESA “Test sequence” page (POST /api/test/process-sequence → process-sequence/v2). Key is server-only.
# ESA_PROCESS_SEQUENCE_API_KEY=
# Optional override URL (defaults to flo-staging …/process-sequence/v2):
# ESA_PROCESS_SEQUENCE_URL=https://staging.example.com/external-service-adapter/v1/process-sequence/v2

# Optional: restrict External APIs “Test request” (POST /api/http-probe) to these hostnames only (comma-separated).
# HTTP_PROBE_HOST_ALLOWLIST=api.sandbox.partner.com,another.vendor.io

# --- Salesforce (optional) — used by GET /api/salesforce/status and /api/salesforce/describe/:sobject.
# OAuth password flow (integration user). Never commit real values; rotate if leaked.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# Append security token to password when required (leave empty if not used):
# SALESFORCE_SECURITY_TOKEN=
# Token URL (sandbox example):
# SALESFORCE_TOKEN_URL=https://test.salesforce.com/services/oauth2/token
# Or set login/instance base (token path is appended automatically):
# SALESFORCE_BASE_URL=https://your-org.sandbox.my.salesforce.com
# REST API version segment:
# SALESFORCE_API_VERSION=v64.0

# HTTP probe — resolve <Object.field> via SOQL (optional):
# Lead → Contact: custom lookup on Lead when the lead is not converted (ConvertedContactId empty):
# SALESFORCE_PROBE_LEAD_CONTACT_LOOKUP=Your_Contact__c
# Child objects keyed by Contact (anchor is Contact Id): JSON map object API name → lookup field on that object
# SALESFORCE_PROBE_OBJECT_CONTACT_FIELD_JSON={"Policy_Parameter__c":"Applicant_Contact__c"}
# Override default Lead__c on custom objects when the probe anchor is a Lead Id:
# SALESFORCE_PROBE_OBJECT_LEAD_FIELD_JSON={"Policy_Parameter__c":"Application_Lead__c"}
